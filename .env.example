# Copy to .env (never commit .env) and fill in your own values.

# --- AI provider (required for real analysis) ---
# Option A — FREE: GitHub Models (uses your GitHub account, daily limits apply)
#   OPENAI_API_KEY  = a GitHub fine-grained token with the "Models: Read" permission
#   OPENAI_BASE_URL = https://models.github.ai/inference
#   OPENAI_MODEL    = openai/gpt-4o
#   OPENAI_CHAT_MODEL = openai/gpt-4o-mini
# Option B — PAID: OpenAI directly
#   OPENAI_API_KEY  = sk-...   (leave OPENAI_BASE_URL empty)
#   OPENAI_MODEL    = gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=https://models.github.ai/inference
OPENAI_MODEL=openai/gpt-4o
# Optional: a lighter model for the follow-up chat (defaults to OPENAI_MODEL)
OPENAI_CHAT_MODEL=openai/gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# --- Demo mode: sample results when no API key is set (UI preview only) ---
DEMO_MODE=false

# --- Upload limits ---
MAX_UPLOAD_MB=8
MAX_IMAGE_SIDE_PX=1600

# --- Abuse protection (per IP) ---
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=600

# Only needed if the frontend is hosted on a different domain than the API,
# comma separated, e.g. https://beati.example.com
ALLOWED_ORIGINS=
